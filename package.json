{
  "name": "olmix-saisie-production",
  "version": "1.0.0",
  "description": "Application de saisie de fin de cycle de production - Olmix Brehan",
  "private": true,
  "main": "dist/electron/main.js",
  "author": "Olmix",
  "license": "UNLICENSED",
  "scripts": {
    "dev": "concurrently -k -n VITE,MAIN,ELECTRON -c cyan,magenta,green \"npm:dev:renderer\" \"npm:dev:main\" \"npm:dev:electron\"",
    "dev:renderer": "vite",
    "dev:main": "node scripts/build-electron.mjs --watch",
    "dev:electron": "wait-on tcp:5273 dist/electron/main.js && cross-env NODE_ENV=development electron .",
    "build": "npm run typecheck && vite build && node scripts/build-electron.mjs",
    "build:web": "npm run typecheck && vite build",
    "typecheck": "tsc --noEmit",
    "dist": "npm run build && electron-builder --win",
    "dist:portable": "npm run build && electron-builder --win portable",
    "exemple:excel": "node scripts/run-ts.mjs scripts/generate-example-excel.ts",
    "test": "node scripts/test-e2e.mjs"
  },
  "dependencies": {
    "exceljs": "^4.4.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@fontsource/libre-baskerville": "^5.3.0",
    "@fontsource/plus-jakarta-sans": "^5.3.0",
    "@types/node": "^22.7.5",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.2",
    "concurrently": "^9.0.1",
    "cross-env": "^7.0.3",
    "electron": "^32.1.2",
    "electron-builder": "^25.1.8",
    "esbuild": "^0.24.0",
    "framer-motion": "^11.11.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.6.2",
    "vite": "^5.4.8",
    "wait-on": "^8.0.1",
    "zustand": "^5.0.0"
  }
}
